{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student profile on ClassMate AI",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string", "minLength": 3, "maxLength": 30 },
        "normalizedUsername": { "type": "string", "minLength": 3, "maxLength": 30 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "courseSection": { "type": "string", "minLength": 2, "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "username", "normalizedUsername", "fullName", "courseSection"]
    },
    "UsernameRecord": {
      "title": "UsernameRecord",
      "description": "Mapping from normalized username to user ID to ensure uniqueness",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["username", "uid"]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Academic document uploaded by student or shared in a room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "roomId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "fileType": { "type": "string" },
        "originalFileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "processingStatus": { "type": "string" },
        "extractedText": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "title", "fileType", "processingStatus"]
    },
    "Reviewer": {
      "title": "Reviewer",
      "description": "Structured AI-generated academic reviewer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "materialId": { "type": "string" },
        "roomId": { "type": "string" },
        "title": { "type": "string" },
        "lessonSummary": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "materialId", "title"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Practice examination generated from study materials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "materialId": { "type": "string" },
        "roomId": { "type": "string" },
        "title": { "type": "string" },
        "difficulty": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "materialId", "title"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz attempt result with scoring and analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quizId": { "type": "string" },
        "studentUid": { "type": "string" },
        "materialId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "quizId", "studentUid", "score", "totalQuestions"]
    },
    "FlashcardDeck": {
      "title": "FlashcardDeck",
      "description": "Study flashcard deck generated from source material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "materialId": { "type": "string" },
        "roomId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerUid", "materialId", "title"]
    },
    "StudyRoom": {
      "title": "StudyRoom",
      "description": "Collaborative study room for classmates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "code": { "type": "string", "minLength": 6, "maxLength": 10 },
        "ownerUid": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roomName", "code", "ownerUid"]
    },
    "RoomMember": {
      "title": "RoomMember",
      "description": "Membership in a study room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "courseSection": { "type": "string" },
        "role": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "roomId", "studentUid", "role"]
    },
    "RoomMessage": {
      "title": "RoomMessage",
      "description": "Discussion message in a study room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderCourse": { "type": "string" },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roomId", "senderUid", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Student user profiles"
    },
    "/usernames/{username}": {
      "schema": "UsernameRecord",
      "description": "Registered usernames registry for uniqueness"
    },
    "/studyMaterials/{materialId}": {
      "schema": "StudyMaterial",
      "description": "Academic study materials and documents"
    },
    "/reviewers/{reviewerId}": {
      "schema": "Reviewer",
      "description": "AI-generated study reviewers"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Generated quizzes"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Completed student quiz attempts"
    },
    "/flashcardDecks/{deckId}": {
      "schema": "FlashcardDeck",
      "description": "Flashcard decks"
    },
    "/studyRooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Collaborative study rooms"
    },
    "/roomMembers/{memberId}": {
      "schema": "RoomMember",
      "description": "Study room memberships"
    },
    "/roomMessages/{messageId}": {
      "schema": "RoomMessage",
      "description": "Study room discussion posts"
    }
  }
}
